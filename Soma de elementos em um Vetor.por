programa
{
	funcao inicio()
	{
inteiro v[5]
inteiro soma = 0
para (inteiro i = 0; i < 5; i++)
		{
escreva("Digite o ", i + 1, "º número: ")
leia(v[i])
soma = soma + v[i]
}

escreva("\nA soma de todas ais coisas  é: ", soma, "\n")
	}
}

